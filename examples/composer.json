{
    "name": "addwiki/example-mediawiki-check",
    "description": "Example script that checks whether a homepage is MediaWiki",
    "type": "project",
    "repositories": [
        {
            "type": "path",
            "url": "../packages/*"
        }
    ],
    "require": {
        "php": ">=8.1",
        "addwiki/mediawiki-api-base": "dev-main",
        "guzzlehttp/guzzle": "^6.5",
        "guzzlehttp/promises": "^1.5"
    },
    "autoload": {
        "psr-4": {
            "Addwiki\\Examples\\MediawikiCheck\\": "src/"
        }
    },
    "config": {
        "audit": {
            "block-insecure": false
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
